{{!
    @template tool_redirectplus/report_tab

    Report tab template for Redirect Plus plugin.

    Context variables required for this template:
    * has_errors - Boolean if errors exist
    * strings - Language strings
    * table_html - HTML table content
    * paging_html - Pagination bar HTML
    * deleteall_url - URL for delete all action
}}

<div class="tab-pane fade show active" id="report">
    <h3>{{#str}}report404, tool_redirectplus{{/str}}</h3>
    <p>{{#str}}report404desc, tool_redirectplus{{/str}}</p>

    {{#has_errors}}
    <div class="tool-redirectplus-actions">
        <a href="{{{deleteall_url}}}" class="btn btn-danger mb-3">{{#str}}deleteallrecords, tool_redirectplus{{/str}}</a>
    </div>

    {{{table_html}}}

    {{{paging_html}}}
    {{/has_errors}}

    {{^has_errors}}
    <div class="alert alert-info">{{#str}}no404errors, tool_redirectplus{{/str}}</div>
    {{/has_errors}}
</div>
