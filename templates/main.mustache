{{!
    @template tool_redirectplus/main

    Main page template for Redirect Plus plugin with tabs.

    Context variables required for this template:
    * report_tab - Report tab HTML content
    * settings_tab - Settings tab HTML content
    * strings - Language strings
}}

<ul class="nav nav-tabs mb-3" id="redirectplus-tabs" role="tablist">
    <li class="nav-item">
        <a class="nav-link active" id="settings-tab" data-bs-toggle="tab" href="#settings" role="tab">{{#str}}tabsettings, tool_redirectplus{{/str}}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="redirects-tab" data-bs-toggle="tab" href="#redirects" role="tab">{{#str}}tabredirects, tool_redirectplus{{/str}}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="report-tab" data-bs-toggle="tab" href="#report" role="tab">{{#str}}tabreport, tool_redirectplus{{/str}}</a>
    </li>
</ul>

<div class="tab-content" id="redirectplus-tab-content">
    {{{settings_tab}}}
    {{{redirects_tab}}}
    {{{report_tab}}}
</div>

{{#js}}
require(['tool_redirectplus/main'], function(Main) {
    Main.init();
});
{{/js}}
