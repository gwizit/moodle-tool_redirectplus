{{!
    @template tool_redirectplus/redirects_tab

    Custom redirects tab template for Redirect Plus plugin.

    Context variables required for this template:
    * has_redirects - Boolean indicating if there are redirects
    * redirects - Array of redirect objects
    * strings - Language strings
    * add_url - URL for adding new redirect
    * sesskey - Session key
}}

<div class="tab-pane fade" id="redirects">
    <div class="card">
        <div class="card-body">
            <h4>{{strings.customredirects}}</h4>
            <p>{{strings.customredirects_desc}}</p>
            
            <div class="alert alert-info mb-4">
                <h5><i class="fa fa-lightbulb-o"></i> {{strings.redirectexamples}}</h5>
                {{{strings.redirectexamples_desc}}}
            </div>

            {{#show_edit_form}}
            <div class="mb-4">
                {{{edit_form_html}}}
            </div>
            <hr>
            {{/show_edit_form}}

            {{^show_edit_form}}
            <div class="mb-3">
                <a href="{{{add_url}}}" class="btn btn-primary" id="btn-add-redirect">
                    <i class="fa fa-plus"></i> {{strings.addredirect}}
                </a>
            </div>
            {{/show_edit_form}}

            <div id="redirect-message-area"></div>

            {{#has_redirects}}
            <div class="table-responsive">
                {{{table_html}}}
            </div>
            {{/has_redirects}}

            {{^has_redirects}}
            <div class="alert alert-info">
                {{strings.noredirects}}
            </div>
            {{/has_redirects}}
        </div>
    </div>
</div>

{{#js}}
require(['jquery'], function($) {
    // Add click handler to "Add New Redirect" button
    $('#btn-add-redirect').on('click', function(e) {
        e.preventDefault();
        var url = $(this).attr('href') + '#redirects';
        window.location.href = url;
    });
    
    // Add click handler to all edit buttons
    $(document).on('click', 'a[href*="action=edit"]', function(e) {
        e.preventDefault();
        var url = $(this).attr('href') + '#redirects';
        window.location.href = url;
    });
});
{{/js}}
