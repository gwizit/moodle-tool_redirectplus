{{!
    @template tool_redirectplus/edit_redirect_form

    Edit/Add redirect form template for Redirect Plus plugin.

    Context variables required for this template:
    * redirect_id - ID of redirect (0 for new)
    * source_url - Source URL value
    * enabled - Whether redirect is enabled
    * destination_url - Destination URL for simple redirects
    * is_simple - Boolean for simple redirect type
    * is_conditional - Boolean for conditional redirect type
    * use_login_param - Boolean for login parameter
    * loggedin_url - URL for logged in users
    * loggedout_url - URL for logged out users
    * use_language_param - Boolean for language parameter
    * language_rules - Array of language rules
    * default_language_url - Default language URL
    * strings - Language strings
    * form_action - Form action URL
    * sesskey - Session key
    * cancel_url - URL to return to
}}

<form method="post" action="{{{form_action}}}" class="mform" id="redirect-form">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="id" value="{{redirect_id}}">
    <input type="hidden" name="action" value="saveredirect">
    
    <!-- Basic Settings -->
    <div class="card mb-3">
        <div class="card-header bg-primary text-white">
            <strong>{{#str}}sourceurl, tool_redirectplus{{/str}}</strong>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label for="id_source_url">{{#str}}sourceurl, tool_redirectplus{{/str}} *</label>
                <input type="text" name="source_url" id="id_source_url" value="{{source_url}}" 
                       class="form-control" placeholder="{{#str}}placeholder_sourceurl, tool_redirectplus{{/str}}" required>
                <small class="form-text text-muted">{{#str}}sourceurl_help, tool_redirectplus{{/str}}</small>
            </div>
            
            <div class="form-group">
                <div class="form-check">
                    <input type="checkbox" name="enabled" id="id_enabled" value="1" class="form-check-input" {{#enabled}}checked{{/enabled}}>
                    <label for="id_enabled" class="form-check-label">{{#str}}enableredirect, tool_redirectplus{{/str}}</label>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Redirect Type -->
    <div class="card mb-3">
        <div class="card-header bg-info text-white">
            <strong>{{#str}}redirectoptions, tool_redirectplus{{/str}}</strong>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label for="id_redirect_type">{{#str}}redirectoptions, tool_redirectplus{{/str}}</label>
                <select name="redirect_type" id="id_redirect_type" class="form-select">
                    <option value="simple" {{#is_simple}}selected{{/is_simple}}>{{#str}}basicredirect, tool_redirectplus{{/str}}</option>
                    <option value="conditional" {{#is_conditional}}selected{{/is_conditional}}>{{#str}}conditionalredirect, tool_redirectplus{{/str}}</option>
                </select>
            </div>
            
            <!-- Simple Redirect -->
            <div id="simple_redirect_section" style="display: none;">
                <div class="form-group">
                    <label for="id_destination_url">{{#str}}destinationurl, tool_redirectplus{{/str}} *</label>
                    <input type="url" name="destination_url" id="id_destination_url" 
                           value="{{destination_url}}" 
                           class="form-control" placeholder="{{#str}}placeholder_destinationurl, tool_redirectplus{{/str}}">
                    <small class="form-text text-muted">{{#str}}destinationurl_help, tool_redirectplus{{/str}}</small>
                </div>
            </div>
            
            <!-- Conditional Redirect -->
            <div id="conditional_redirect_section" style="display: none;">
                <p class="text-info">{{#str}}parametersnote, tool_redirectplus{{/str}}</p>
                
                <!-- Login Parameter -->
                <div class="form-group">
                    <div class="form-check">
                        <input type="checkbox" name="use_login_param" id="id_use_login_param" value="1" 
                               class="form-check-input" {{#use_login_param}}checked{{/use_login_param}}>
                        <label for="id_use_login_param" class="form-check-label fw-bold">
                            {{#str}}useloginparam, tool_redirectplus{{/str}}
                        </label>
                    </div>
                    <small class="form-text text-muted">{{#str}}useloginparam_help, tool_redirectplus{{/str}}</small>
                </div>
                
                <div id="login_param_section" style="display: none;">
                    <div class="form-group ms-4">
                        <label for="id_loggedin_url">{{#str}}loggedin_url, tool_redirectplus{{/str}}</label>
                        <input type="url" name="loggedin_url" id="id_loggedin_url" 
                               value="{{loggedin_url}}" 
                               class="form-control" placeholder="{{#str}}placeholder_loggedin_url, tool_redirectplus{{/str}}">
                    </div>
                    
                    <div class="form-group ms-4">
                        <label for="id_loggedout_url">{{#str}}loggedout_url, tool_redirectplus{{/str}}</label>
                        <input type="url" name="loggedout_url" id="id_loggedout_url" 
                               value="{{loggedout_url}}" 
                               class="form-control" placeholder="{{#str}}placeholder_loggedout_url, tool_redirectplus{{/str}}">
                    </div>
                </div>
                
                <hr>
                
                <!-- Language Parameter -->
                <div class="form-group">
                    <div class="form-check">
                        <input type="checkbox" name="use_language_param" id="id_use_language_param" value="1" 
                               class="form-check-input" {{#use_language_param}}checked{{/use_language_param}}>
                        <label for="id_use_language_param" class="form-check-label fw-bold">
                            {{#str}}uselanguageparam, tool_redirectplus{{/str}}
                        </label>
                    </div>
                    <small class="form-text text-muted">{{#str}}uselanguageparam_help, tool_redirectplus{{/str}}</small>
                </div>
                
                <div id="language_param_section" style="display: none;">
                    <!-- Language Detection Methods -->
                    <div class="form-group ms-4 mb-3">
                        <label class="fw-bold">{{#str}}detectlanguageby, tool_redirectplus{{/str}}</label>
                        <small class="form-text text-muted mb-2">{{#str}}detectlanguageby_help, tool_redirectplus{{/str}}</small>
                        <div class="form-check">
                            <input type="checkbox" name="detect_language_browser" id="id_detect_language_browser" value="1" 
                                   class="form-check-input language-detection-method" {{#detect_language_browser}}checked{{/detect_language_browser}}>
                            <label for="id_detect_language_browser" class="form-check-label">
                                {{#str}}detectlanguagebrowser, tool_redirectplus{{/str}}
                            </label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" name="detect_language_moodle" id="id_detect_language_moodle" value="1" 
                                   class="form-check-input language-detection-method" {{#detect_language_moodle}}checked{{/detect_language_moodle}}>
                            <label for="id_detect_language_moodle" class="form-check-label">
                                {{#str}}detectlanguagemoodle, tool_redirectplus{{/str}}
                            </label>
                        </div>
                    </div>
                    
                    <div class="alert alert-info ms-4 mb-3">
                        <strong><i class="fa fa-info-circle"></i> {{#str}}language_priority_title, tool_redirectplus{{/str}}</strong>
                        <p class="mb-1">{{#str}}language_priority_desc, tool_redirectplus{{/str}}</p>
                        <ul class="mb-0">
                            <li>{{#str}}language_wildcard_exact, tool_redirectplus{{/str}}</li>
                            <li>{{#str}}language_wildcard_partial, tool_redirectplus{{/str}}</li>
                            <li>{{#str}}language_wildcard_all, tool_redirectplus{{/str}}</li>
                        </ul>
                    </div>
                    
                    <div id="language_rules_container" class="ms-4">
                        {{#language_rules}}
                        <div class="language-rule-row mb-3 pb-3" style="border-bottom: 1px solid #dee2e6;">
                            <div class="mb-2 d-flex justify-content-between align-items-center">
                                <strong>{{#str}}languagerule, tool_redirectplus{{/str}} #<span class="rule-number">{{number}}</span></strong>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-secondary move-rule-up" title="{{#str}}moveup, tool_redirectplus{{/str}}">
                                        <i class="fa fa-arrow-up"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary move-rule-down" title="{{#str}}movedown, tool_redirectplus{{/str}}">
                                        <i class="fa fa-arrow-down"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <input type="text" name="language_code[]" value="{{lang}}" 
                                           class="form-control" placeholder="{{#str}}languagecode, tool_redirectplus{{/str}}">
                                    <small class="form-text text-muted">{{#str}}languagecode_help, tool_redirectplus{{/str}}</small>
                                </div>
                                <div class="col-md-6">
                                    <input type="url" name="language_url[]" value="{{url}}" 
                                           class="form-control" placeholder="{{#str}}languageurl, tool_redirectplus{{/str}}">
                                    <button type="button" class="btn btn-danger btn-sm remove-language-rule mt-2" {{#is_first}}style="display: none;"{{/is_first}}>
                                        {{#str}}delete, tool_redirectplus{{/str}}
                                    </button>
                                </div>
                            </div>
                        </div>
                        {{/language_rules}}
                    </div>
                    
                    <div class="ms-4 mb-3">
                        <button type="button" id="add_language_rule" class="btn btn-sm btn-secondary">
                            <i class="fa fa-plus"></i> {{#str}}addlanguagerule, tool_redirectplus{{/str}}
                        </button>
                    </div>
                    
                    <div class="form-group ms-4">
                        <label for="id_default_language_url" class="fw-bold">{{#str}}defaultlanguageurl, tool_redirectplus{{/str}}</label>
                        <input type="url" name="default_language_url" id="id_default_language_url" 
                               value="{{default_language_url}}" 
                               class="form-control" placeholder="{{#str}}placeholder_default_language_url, tool_redirectplus{{/str}}">
                        <small class="form-text text-muted">{{#str}}defaultlanguageurl_help, tool_redirectplus{{/str}}</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Actions -->
    <div class="form-group">
        <button type="submit" class="btn btn-primary">{{#str}}saveredirect, tool_redirectplus{{/str}}</button>
        <a href="{{{cancel_url}}}#redirects" class="btn btn-secondary" id="btn-cancel-redirect">{{#str}}cancel, tool_redirectplus{{/str}}</a>
    </div>
</form>

{{#js}}
require(['tool_redirectplus/edit_redirect_form'], function(EditRedirectForm) {
    EditRedirectForm.init({
        cancel_url: '{{{cancel_url}}}',
        strings: {
            languagerule: '{{js_strings.languagerule}}',
            moveup: '{{js_strings.moveup}}',
            movedown: '{{js_strings.movedown}}',
            languagecode: '{{js_strings.languagecode}}',
            languagecode_help: '{{js_strings.languagecode_help}}',
            languageurl: '{{js_strings.languageurl}}',
            delete: '{{js_strings.delete}}',
            detectlanguageerror: '{{js_strings.detectlanguageerror}}'
        }
    });
});
{{/js}}

