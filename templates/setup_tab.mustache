{{!
    @template tool_redirectplus/setup_tab

    Setup instructions tab template for Redirect Plus plugin.

    Context variables required for this template:
    * error404_url - Full URL to error404.php
    * strings - Language strings
}}

<div class="tab-pane" id="setup">
    <h3>{{strings.setupinstructions}}</h3>

    <div class="alert alert-info">
        <p>{{strings.setupintro}}</p>
        <p><strong>{{strings.your404url}}</strong> <code class="p-2 bg-light d-inline-block">{{error404_url}}</code></p>
    </div>

    <div class="mb-4">
        <h4>{{strings.testtracking}}</h4>
        <p>{{strings.testtracking_desc}}</p>
        <a href="{{error404_url}}?url=/test-404-page" target="_blank" class="btn btn-secondary">{{strings.test404page}}</a>
        <p class="mt-2"><small class="text-muted">{{strings.test404note}}</small></p>
    </div>

    <h4>{{strings.serverconfiguration}}</h4>

    <!-- Apache Instructions -->
    <div class="card mb-3">
        <div class="card-header">
            <a href="#" id="apacheToggle" class="text-decoration-none text-dark font-weight-bold">
                {{strings.apache_htaccess}} ▼
            </a>
        </div>
        <div id="collapseApache" class="collapse show">
            <div class="card-body">
                <p>{{strings.apache_instructions}}</p>
                <pre><code>ErrorDocument 404 {{error404_url}}?url=%{REQUEST_URI}</code></pre>
                <p class="text-muted mt-2"><small>{{strings.apache_note}}</small></p>
            </div>
        </div>
    </div>

    <!-- Nginx Instructions -->
    <div class="card mb-3">
        <div class="card-header">
            <a href="#" id="nginxToggle" class="text-decoration-none text-dark font-weight-bold">
                {{strings.nginx}} ▶
            </a>
        </div>
        <div id="collapseNginx" class="collapse">
            <div class="card-body">
                <p>{{strings.nginx_instructions}}</p>
                <pre><code>error_page 404 {{error404_url}}?url=$request_uri;</code></pre>
                <p class="text-muted mt-2"><small>{{strings.nginx_note}}</small></p>
            </div>
        </div>
    </div>

    <!-- Plesk Instructions -->
    <div class="card mb-3">
        <div class="card-header">
            <a href="#" id="pleskToggle" class="text-decoration-none text-dark font-weight-bold">
                {{strings.plesk}} ▶
            </a>
        </div>
        <div id="collapsePlesk" class="collapse">
            <div class="card-body">
                <p>{{strings.plesk_instructions}}</p>
                <ol>
                    <li>{{strings.plesk_step1}}</li>
                    <li>{{strings.plesk_step2}}</li>
                    <li>{{strings.plesk_step3}}</li>
                    <li>ErrorDocument 404 {{error404_url}}?url=%{REQUEST_URI}</li>
                </ol>
            </div>
        </div>
    </div>
</div>

{{#js}}
require(['tool_redirectplus/settings'], function(Settings) {
    Settings.init({
        apacheText: '{{strings.apache_htaccess}}',
        nginxText: '{{strings.nginx}}',
        pleskText: '{{strings.plesk}}'
    });
});
{{/js}}
