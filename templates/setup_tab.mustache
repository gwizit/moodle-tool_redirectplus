{{!
    @template tool_redirectplus/setup_tab

    Setup instructions tab template for Redirect Plus plugin.

    Context variables required for this template:
    * error404_url - Full URL to error404.php
    * wwwroot - Moodle root URL
    * strings - Language strings
}}

<div class="tab-pane fade" id="setup">
    <h3>{{strings.setupinstructions}}</h3>

    <!-- 404 URL Display -->
    <div class="alert alert-danger">
        <h4 class="text-danger"><strong>{{strings.your404url}}</strong></h4>
        <code class="p-2 bg-white d-inline-block" style="font-size: 1.1em;">{{error404_url}}</code>
    </div>

    <h4>{{strings.serverconfiguration}}</h4>
    <p class="text-muted">{{strings.config_recommendation}}</p>

    <!-- Apache Instructions -->
    <div class="card mb-3">
        <div class="card-header bg-success text-white">
            <a href="#" id="apacheToggle" class="text-decoration-none text-white font-weight-bold">
                <strong>{{strings.apache_method}}</strong> ({{strings.recommended}}) ▼
            </a>
        </div>
        <div id="collapseApache" class="collapse show">
            <div class="card-body">
                <p>{{strings.apache_instructions}}</p>
                <pre><code>ErrorDocument 404 {{error404_url}}?url=%{REQUEST_URI}</code></pre>
                <p class="text-muted mt-2"><small>{{strings.apache_note}}</small></p>
            </div>
        </div>
    </div>

    <!-- Nginx Instructions -->
    <div class="card mb-3">
        <div class="card-header bg-success text-white">
            <a href="#" id="nginxToggle" class="text-decoration-none text-white font-weight-bold">
                <strong>{{strings.nginx_method}}</strong> ({{strings.recommended}}) ▶
            </a>
        </div>
        <div id="collapseNginx" class="collapse">
            <div class="card-body">
                <p>{{strings.nginx_instructions}}</p>
                <pre><code>error_page 404 {{error404_url}}?url=$request_uri;</code></pre>
                <p class="text-muted mt-2"><small>{{strings.nginx_note}}</small></p>
            </div>
        </div>
    </div>

    <!-- .htaccess Manual Configuration Method -->
    <div class="card mb-3">
        <div class="card-header bg-warning">
            <a href="#" id="htaccessToggle" class="text-decoration-none text-dark font-weight-bold">
                <strong>{{strings.htaccess_method}}</strong> ({{strings.fallback_only}}) ▶
            </a>
        </div>
        <div id="collapseHtaccess" class="collapse">
            <div class="card-body">
                <div class="alert alert-danger">
                    <strong>{{strings.htaccess_warning_title}}</strong>
                    <p>{{{strings.htaccess_warning}}}</p>
                </div>
                
                <div class="alert alert-info">
                    <strong><i class="fa fa-info-circle"></i> {{strings.htaccess_backup_title}}</strong>
                    <p>{{strings.htaccess_backup_warning}}</p>
                </div>
                
                <h5>{{strings.htaccess_manual_instructions_title}}</h5>
                <p>{{strings.htaccess_manual_step1}}</p>
                <p>{{strings.htaccess_manual_step2}}</p>
                
                <pre class="bg-light p-3"><code>php_value auto_prepend_file "{{wwwroot}}/admin/tool/redirectplus/prepend.php"</code></pre>
                
                <p class="text-muted mt-2"><small>{{strings.htaccess_manual_note}}</small></p>
            </div>
        </div>
    </div>

    <!-- Test Section -->
    <div class="card mb-3 mt-4">
        <div class="card-header bg-primary text-white">
            <strong>{{strings.test_configuration}}</strong>
        </div>
        <div class="card-body">
            <p>{{strings.test_configuration_desc}}</p>
            <button type="button" id="btn-test-404" class="btn btn-primary">
                <i class="fa fa-flask"></i> {{strings.test_404_tracking}}
            </button>
            <div id="test-result-container" class="mt-3"></div>
        </div>
    </div>
</div>

{{#js}}
require(['tool_redirectplus/setup'], function(Setup) {
    Setup.init({
        wwwroot: '{{wwwroot}}',
        error404url: '{{error404_url}}',
        apacheText: '{{strings.apache_method}}',
        nginxText: '{{strings.nginx_method}}',
        htaccessText: '{{strings.htaccess_method}}',
        strings: {
            checking: '{{strings.checking_status}}',
            enabled: '{{strings.htaccess_enabled}}',
            disabled: '{{strings.htaccess_disabled}}',
            enabling: '{{strings.enabling}}',
            disabling: '{{strings.disabling}}',
            success: '{{strings.operation_success}}',
            error: '{{strings.operation_error}}',
            testing: '{{strings.testing}}',
            test_success: '{{strings.test_success}}',
            test_failure: '{{strings.test_failure}}',
            test_error: '{{strings.test_error}}'
        }
    });
});
{{/js}}
